# Worzel ESP32 Client — ESP-IDF defaults
# Override via menuconfig or sdkconfig.local

# WiFi (override before building)
CONFIG_WORZEL_WIFI_SSID="myssid"
CONFIG_WORZEL_WIFI_PASS="mypassword"
# Server (override before building — set your Tailscale Funnel hostname or local IP)
CONFIG_WORZEL_SERVER_HOST="myserver.example.com"
CONFIG_WORZEL_SERVER_PORT="443"
CONFIG_WORZEL_USE_TLS=y

# PSRAM (ESP32-S3 AMOLED has 8MB Octal PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Console output via USB-Serial/JTAG (ESP32-S3 has no external UART-to-USB chip)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# CPU at 240MHz (default 160MHz) — Opus float encode needs all the speed it can get
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Increase main task stack for cJSON allocations
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# WebSocket task stack is set programmatically in main.c (task_stack = 12288)
# because the Kconfig symbol varies between esp_websocket_client versions.

# LVGL fonts — montserrat_14 is on by default; 28-36 for conversation cycling
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_34=y
CONFIG_LV_FONT_MONTSERRAT_36=y

# Flash size — set per board via sdkconfig.flash-NNmb chained in platformio.ini.
# Do NOT set CONFIG_ESPTOOLPY_FLASHSIZE here (causes mismatch warnings).
