{
  "name": "worzel",
  "version": "0.1.0",
  "description": "Hardened voice assistant server for ESP32 devices",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc && cp src/web-client/index.html src/web-client/app.js src/web-client/pcm-processor.js src/web-client/opus-encoder.js src/web-client/favicon.ico dist/web-client/ && cp -r src/web-client/i18n dist/web-client/ && cp -r src/web-client/styles dist/web-client/ && node scripts/bundle-vendor.js",
    "start": "bash scripts/unified-server.sh start",
    "start:bg": "bash scripts/unified-server.sh start",
    "start:fg": "bash scripts/unified-server.sh run-fg",
    "stop": "bash scripts/unified-server.sh stop",
    "restart": "bash scripts/unified-server.sh restart",
    "status": "bash scripts/unified-server.sh status",
    "logs": "bash scripts/unified-server.sh logs",
    "dev": "tsx --watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "debug:index": "node dist/index.js",
    "debug:dev": "tsx src/index.ts",
    "debug:fink": "node --env-file=../.env dist/fink/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.2",
    "@supabase/supabase-js": "^2.100.1",
    "fastify": "^5.2.1",
    "inkjs": "^2.4.0",
    "isolated-vm": "^6.0.2",
    "opusscript": "^0.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "overrides": {
    "iceberg-js": "0.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
